{
  "name": "tiled-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "A safety-first MCP server for inspecting and editing Tiled maps.",
  "type": "module",
  "bin": {
    "tiled-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "tsx scripts/generate-mcp-contract.ts --check",
    "contract:generate": "tsx scripts/generate-mcp-contract.ts --write",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "pnpm run contract:check && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest --exclude tests/stdio.test.ts",
    "test:stdio": "pnpm run build && vitest run tests/stdio.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run contract:check && vitest run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
